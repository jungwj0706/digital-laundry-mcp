# Runtime
NODE_ENV=development
DL_DEMO_MODE=true
DL_LOG_LEVEL=info

# Public web search (required for live search). Kakao Developers REST API key.
KAKAO_REST_API_KEY=

# Optional image web detection; only called after per-call explicit consent
GOOGLE_CLOUD_VISION_API_KEY=

# Local data
DL_ENABLE_PERSISTENCE=false
DL_DATA_ENCRYPTION_KEY=
DL_DATABASE_PATH=./data/digital-laundry.sqlite
DL_RETENTION_DAYS=30
DL_EXPORT_DIR=./data/exports

# Request limits
DL_SEARCH_MAX_QUERIES=20
DL_SEARCH_MAX_RESULTS=20
DL_HTTP_TIMEOUT_MS=8000
DL_HTTP_MAX_BYTES=2097152
DL_IMAGE_MAX_BYTES=5242880

# Remote MCP is one loopback URL: http://localhost:3333/mcp
# npm run start:http
# Set a token of at least 16 characters only when a client can send Authorization.
DL_HTTP_ENABLED=true
DL_HTTP_PORT=3333
DL_HTTP_AUTH_TOKEN=
